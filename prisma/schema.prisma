generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  name                 String
  passwordHash         String
  plan                 String   @default("free")
  planInterval         String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  overlayToken         String   @unique
  liveVideoId          String?
  videosUsedMonth      Int      @default(0)
  ideasUsedMonth       Int      @default(0)
  scriptsUsedMonth     Int      @default(0)
  usageMonth           String   @default("")
  ownerUserId          String?
  owner                User?    @relation("Membros", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members              User[]   @relation("Membros")
  invitesSent          MemberInvite[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  analyses             Analysis[]
  channels             Channel[]
  scripts              Script[]
}

model MemberInvite {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([ownerId, email])
}

model Channel {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeId  String
  title      String
  thumbnail  String?
  createdAt  DateTime @default(now())

  @@unique([userId, youtubeId])
}

model Analysis {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String   @default("vod")
  videoId      String
  videoTitle   String
  channelName  String
  channelId    String?
  thumbnailUrl         String?
  commentCount         Int      @default(0)
  youtubeCommentTotal  Int      @default(0)
  ingestedCount        Int      @default(0)
  source               String   @default("demo")
  statsJson    String
  commentsJson String
  createdAt    DateTime @default(now())
  scripts      Script[]

  @@index([userId, createdAt])
}

model Script {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId   String?
  analysis     Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  ideaTitle    String
  title        String
  contentJson  String
  scheduledFor DateTime?
  createdAt    DateTime  @default(now())
}
