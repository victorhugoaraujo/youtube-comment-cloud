# Prisma Postgres (Vercel Storage) or any Postgres connection string.
# After connecting the database in Vercel: `npx vercel env pull .env.local`
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

AUTH_SECRET="generate-a-long-random-string"
APP_URL="http://localhost:4317"

# YouTube Data API v3 — comentários públicos e chat de live
YOUTUBE_API_KEY=""

# OpenAI — resumo, ideias e roteiros
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Stripe — adiado. Deixe vazio: ativar plano só libera features, sem cobrança.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""
